# Postgres connection string (local: see docker-compose.yml; hosted: from Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/growthscape"
# Long random string used to sign login sessions (32+ characters)
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Admin password set when the database is first seeded (required in production)
ADMIN_PASSWORD=""
# Protects /api/cron/snapshot (Vercel sends it as a Bearer token)
CRON_SECRET=""
