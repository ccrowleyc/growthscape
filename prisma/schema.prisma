generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  isAdmin      Boolean      @default(false)
  createdById  String?
  createdBy    User?        @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]       @relation("CreatedUsers")
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  memberships Membership[]
  owners      Owner[]
  models      ValuationModel[]
  valuations  Valuation[]
  initiatives StrategicInitiative[]
  plans       ValueCreationPlan[]
  assessments Assessment[]
  createdAt   DateTime     @default(now())
}

/// A user's access to a company. role: ADMIN | MEMBER
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("MEMBER")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

/// People who can own Strategic Initiatives within a company
model Owner {
  id        String   @id @default(cuid())
  companyId String
  name      String
  title     String?
  email     String?
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  initiatives StrategicInitiative[]
  createdAt   DateTime              @default(now())
}

model ValuationModel {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  description String?
  formula     String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis        ModelKpi[]
  valuations  Valuation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([companyId, name])
}

/// A KPI a model's formula uses. kind: PRIMARY | COEFFICIENT. unit: CURRENCY | PERCENT | NUMBER
model ModelKpi {
  id        String         @id @default(cuid())
  modelId   String
  code      String
  name      String
  kind      String         @default("PRIMARY")
  unit      String         @default("NUMBER")
  sortOrder Int            @default(0)
  model     ValuationModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, code])
}

/// kind: CURRENT | TARGET. inputs: JSON map of KPI code -> number.
/// savedValue is the result when last saved; the live value is always recomputed from the model.
model Valuation {
  id         String         @id @default(cuid())
  companyId  String
  modelId    String
  name       String
  kind       String         @default("CURRENT")
  asOf       DateTime
  inputs     String
  savedValue Float?
  notes      String?
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  model      ValuationModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  baselineOf ValueCreationPlan[] @relation("PlanBaseline")
  targetOf   ValueCreationPlan[] @relation("PlanTarget")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([companyId, name])
}

/// Quarters are strings like "2026-Q1". kpiCodes is a JSON array of KPI codes.
model StrategicInitiative {
  id           String                 @id @default(cuid())
  companyId    String
  name         String
  description  String?
  ownerId      String?
  startQuarter String
  endQuarter   String
  kpiCodes     String                 @default("[]")
  budget       Float?
  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner        Owner?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  adjustments  InitiativeAdjustment[]
  plans        PlanInitiative[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([companyId, name])
}

/// Planned and actual change to one KPI in one quarter (additive; percent KPIs as decimals).
model InitiativeAdjustment {
  id           String              @id @default(cuid())
  initiativeId String
  quarter      String
  kpiCode      String
  planned      Float?
  actual       Float?
  initiative   StrategicInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@unique([initiativeId, quarter, kpiCode])
}

model ValueCreationPlan {
  id                  String            @id @default(cuid())
  companyId           String
  name                String
  description         String?
  baselineValuationId String
  targetValuationId   String
  marginPct           Float             @default(0.05)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  baseline            Valuation         @relation("PlanBaseline", fields: [baselineValuationId], references: [id], onDelete: Restrict)
  target              Valuation         @relation("PlanTarget", fields: [targetValuationId], references: [id], onDelete: Restrict)
  initiatives         PlanInitiative[]
  otherAdjustments    PlanAdjustment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([companyId, name])
}

model PlanInitiative {
  planId       String
  initiativeId String
  plan         ValueCreationPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  initiative   StrategicInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  @@id([planId, initiativeId])
}

/// KPI changes not driven by an initiative, e.g. inflation reducing EBITDA.
model PlanAdjustment {
  id      String            @id @default(cuid())
  planId  String
  label   String
  kpiCode String
  amount  Float
  plan    ValueCreationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Assessment {
  id        String          @id @default(cuid())
  companyId String
  name      String
  asOf      DateTime
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis      AssessmentKpi[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

/// direction: HIGHER | LOWER (which way is better). source: MANUAL | CSV | a named system.
model AssessmentKpi {
  id           String     @id @default(cuid())
  assessmentId String
  pillar       String
  name         String
  unit         String     @default("NUMBER")
  direction    String     @default("HIGHER")
  target       Float?
  actual       Float?
  prior        Float?
  source       String     @default("MANUAL")
  sourceDetail String?
  sortOrder    Int        @default(0)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}
