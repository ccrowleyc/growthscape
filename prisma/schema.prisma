generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  isAdmin      Boolean      @default(false)
  createdById  String?
  createdBy    User?        @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers User[]       @relation("CreatedUsers")
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  memberships Membership[]
  owners      Owner[]
  models      ValuationModel[]
  valuations  Valuation[]
  createdAt   DateTime     @default(now())
}

/// A user's access to a company. role: ADMIN | MEMBER
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("MEMBER")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

/// People who can own Strategic Initiatives within a company
model Owner {
  id        String   @id @default(cuid())
  companyId String
  name      String
  title     String?
  email     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ValuationModel {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  description String?
  formula     String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kpis        ModelKpi[]
  valuations  Valuation[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([companyId, name])
}

/// A KPI a model's formula uses. kind: PRIMARY | COEFFICIENT. unit: CURRENCY | PERCENT | NUMBER
model ModelKpi {
  id        String         @id @default(cuid())
  modelId   String
  code      String
  name      String
  kind      String         @default("PRIMARY")
  unit      String         @default("NUMBER")
  sortOrder Int            @default(0)
  model     ValuationModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, code])
}

/// kind: CURRENT | TARGET. inputs: JSON map of KPI code -> number.
/// savedValue is the result when last saved; the live value is always recomputed from the model.
model Valuation {
  id         String         @id @default(cuid())
  companyId  String
  modelId    String
  name       String
  kind       String         @default("CURRENT")
  asOf       DateTime
  inputs     String
  savedValue Float?
  notes      String?
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  model      ValuationModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([companyId, name])
}
